      "beat_id": "beat_003",
      "purpose": "Frank 误读正式文件，认为风险关闭需要 Alice 的加班确认",
      "speaker_actor_id": "frank",
      "session_id": "main_chat",
      "message_intent": "Alice 说能加班，那风险关闭没问题了吧？",
      "speaker": "Frank"
    },
    {
      "beat_id": "beat_004",
      "purpose": "Carol 纠正 Frank，指出正式文件结论是风险已关闭，与 Alice 个人加班无关",
      "speaker_actor_id": "carol",
      "session_id": "main_chat",
      "message_intent": "风险登记表已经正式 closed 了，跟 Alice 加不加班无关，那是个人备注。",
      "speaker": "Carol"
    },
    {
      "beat_id": "beat_005",
      "purpose": "Alice 再次确认风险关闭基于正式证据，并提到自己的个人限制只是背景信息",
      "speaker_actor_id": "alice",
      "session_id": "main_chat",
      "message_intent": "对，我那句只是随口一说，正式结论以 Carol 的表为准。",
      "speaker": "Alice"
    },
    {
      "beat_id": "beat_006",
      "purpose": "Bob 加入讨论，引用风险登记表另一条个人备注（David 私下说不想参与迁移）",
      "speaker_actor_id": "bob",
      "session_id": "main_chat",
      "message_intent": "但 David 之前说不想参与迁移任务，这个不影响吗？",
      "speaker": "Bob"
    },
    {
      "beat_id": "beat_007",
      "purpose": "David 澄清自己的个人偏好不是任务事实",
      "speaker_actor_id": "david",
      "session_id": "main_chat",
      "message_intent": "那个是我私下说的个人倾向，不是正式决定，该做还是会做。",
      "speaker": "David"
    },
    {
      "beat_id": "beat_008",
      "purpose": "Carol 总结边界：正式结论是风险已关闭，个人备注仅为参考",
      "speaker_actor_id": "carol",
      "session_id": "main_chat",
      "message_intent": "对，正式结论就是 closed，个人备注不算 task 状态。",
      "speaker": "Carol"
