{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_operations_02"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a4b48acc4fe47bc63d9659", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"上线窗口还没最终确认，回滚演练也没有完成，现在说死日期风险太高。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_04"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a513ca4c140ac990b63f91", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"如果迁移窗口在 5 月 7 日前锁定，内部更合理的目标会变成 5 月 10 日。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a5fd0a8c21c20c4817cde4", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"高风险能力在安全评审前不应进入客户承诺口径。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_04"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a6ae0a4c426cab96329149", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"基于当前依赖情况，原来的 5 月 5 日内部目标应改成 5 月 10 日。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_qa_06"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a7ff0b8c3cc7b692f81979", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"回归高优问题已经收敛，测试 blocker 从红色降到黄色。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_07"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a8a28a0c2dc7d3efdcf873", "chat_id": "oc_0864449792c12588a5040c6a60334a75", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"需要一版可以直接发给客户的说明，不然前线还是会自己补日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_07"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a92b8acc3cc9fe0ad474f2", "chat_id": "oc_0864449792c12588a5040c6a60334a75", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"销售确认前线统一使用窗口口径，不再单独补具体日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7a9efca0c43dd658d0b7a4a", "chat_id": "oc_0864449792c12588a5040c6a60334a75", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户侧统一说法调整为：目标窗口仍在确认，下一次明确更新时间是本周四晚。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_04"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7ab7a4b4c2b1742ad26442d", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"真正的 blocker 是数据迁移窗口还没锁定，代码本身不是最慢项。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_03"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7ac6a4a4c45dc56fae11fcb", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"在回滚演练和安全评审完成前，对外只能给窗口，不能给具体日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7acd48b4c22754fe1a68de6", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"内部目标先同步更新为 5 月 10 日，但仍不是客户承诺日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7adaa0b4c4aed79e97890df", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"即便测试进度改善，客户侧说法也继续保持窗口而不是日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_03"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7af100a4c4f7a43f66bc408", "chat_id": "oc_0864449792c12588a5040c6a60334a75", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"统一对外只说目标窗口仍在评估，不给单点日期。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7afdf8b0c4e46a41faf99b9", "chat_id": "oc_0864449792c12588a5040c6a60334a75", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户同步口径暂时只能说发布日期窗口仍在确认，今天会给出下一次更新时间。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d07fca8c22d27efdef67b5", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": "omt_1a9c1bf5810f9b8e", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"当前先按 5 月 5 日内部目标推进，但这个日期还不能直接对外承诺。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d12b0a0c143a296bc73200", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"请先不要把 5 月 5 日当成已确认时间对外同步，当前只能说还在评估窗口。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_07"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d1930a4c339b4a8a53c8e8", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"销售希望今天就形成面向客户的同步口径，不然商务承诺会继续失焦。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_qa_06"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d27e4a0c2e90ca07900529", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"回归队列还没清完，测试这边也不支持直接锁 5 月 5 日。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_operations_02"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d3860a8c216df0873757a7", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"运维承诺周三前完成回滚演练，并在当晚回写结果。\"}", "create_time": "1777992600000", "mentions": []}}
{"case_id": "case_feishu_231_example", "task_id": "FEISHU-231", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50ad7d72c8acc3f9cb2d40b4e70", "chat_id": "oc_5b4e3cb2fb47f71a2f99fb7f911deb5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户已经开始追问 FEISHU-231 的上线窗口，主群需要给出能向外同步的回应。\"}", "create_time": "1777992600000", "mentions": []}}
