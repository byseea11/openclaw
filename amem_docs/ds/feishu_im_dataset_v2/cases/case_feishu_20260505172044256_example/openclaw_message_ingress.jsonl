{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe60704a0c2b4fc5aef4f5ba", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"即便测试进度改善，客户侧说法也继续保持窗口而不是日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe62788a8c32c35562aa62f2", "chat_id": "oc_6d792fe5f09454d821fc84785a7a6f5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户同步口径暂时只能说发布日期窗口仍在确认，今天会给出下一次更新时间。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe63838acc4d024e5c4c9656", "chat_id": "oc_6d792fe5f09454d821fc84785a7a6f5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"统一对外只说目标窗口仍在评估，不给单点日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_operations_07"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe65840b4c45824100bf628c", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"运维承诺周三前完成回滚演练，并在当晚回写结果。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe665b4a8c4a3609478d2447", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"内部目标先同步更新为 5 月 10 日，但仍不是客户承诺日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe67ad4a4c114f92c8af752e", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"在回滚演练和安全评审完成前，对外只能给窗口，不能给具体日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe68920b0c21ded0f054cbdc", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"当前先按 5 月 5 日内部目标推进，但这个日期还不能直接对外承诺。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_03"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe691b4b0c3129a8057bb772", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"销售希望今天就形成面向客户的同步口径，不然商务承诺会继续失焦。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe6a4b4a4c2bc2ecc0cf365a", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"请先不要把 5 月 5 日当成已确认时间对外同步，当前只能说还在评估窗口。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_qa_02"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe6b178b0c2dea828d1c81a1", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"回归队列还没清完，测试这边也不支持直接锁 5 月 5 日。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe6f8e4a0c4c63605dfc88d1", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户已经开始追问 FEISHU-20260505172044256 的上线窗口，主群需要给出能向外同步的回应。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_operations_07"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe78938a0c37eb4247fbc9cc", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"上线窗口还没最终确认，回滚演练也没有完成，现在说死日期风险太高。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_08"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe790dca8c14a4ffc4c8d461", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"如果迁移窗口在 5 月 7 日前锁定，内部更合理的目标会变成 5 月 10 日。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_security_06"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe79de0acc3b9e601da0810d", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"高风险能力在安全评审前不应进入客户承诺口径。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_08"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7a504a0c2edeec947d9d8a", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"基于当前依赖情况，原来的 5 月 5 日内部目标应改成 5 月 10 日。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_qa_02"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7b948a0c2ae36243f933c3", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"回归高优问题已经收敛，测试 blocker 从红色降到黄色。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_management_01"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7c3d8b0c43c3618171cec4", "chat_id": "oc_6d792fe5f09454d821fc84785a7a6f5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"客户侧统一说法调整为：目标窗口仍在确认，下一次明确更新时间是本周四晚。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_03"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7cf24acc3955ca383c3faa", "chat_id": "oc_6d792fe5f09454d821fc84785a7a6f5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"需要一版可以直接发给客户的说明，不然前线还是会自己补日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_sales_03"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7d144a8c3cc7e0f4d01e0f", "chat_id": "oc_6d792fe5f09454d821fc84785a7a6f5b", "chat_type": "group", "thread_id": null, "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"销售确认前线统一使用窗口口径，不再单独补具体日期。\"}", "create_time": "1778002680000", "mentions": []}}
{"case_id": "case_feishu_20260505172044256_example", "task_id": "FEISHU-20260505172044256", "event_type": "im.message.receive_v1", "sender": {"sender_id": {"open_id": "ou_sim_engineering_08"}, "sender_type": "user"}, "message": {"message_id": "om_x100b50afe7f5b8a4c36c23d5a626fc6", "chat_id": "oc_8f2d78d241055ad28c1e7eb8eb1503e0", "chat_type": "group", "thread_id": "omt_1a9c324d6cce1b8d", "root_id": null, "parent_id": null, "message_type": "text", "content": "{\"text\":\"真正的 blocker 是数据迁移窗口还没锁定，代码本身不是最慢项。\"}", "create_time": "1778002680000", "mentions": []}}
